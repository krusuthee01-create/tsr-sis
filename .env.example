# คัดลอกเป็น .env.local แล้วใส่ค่าจาก Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# ใช้ Publishable key (sb_publishable_...) หรือ legacy anon key (eyJ...) ก็ได้
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# ใช้เฉพาะฝั่งเซิร์ฟเวอร์ สำหรับสร้างบัญชีชื่อผู้ใช้/รหัสผ่าน ห้ามเปิดเผย
# ใช้ Secret key (sb_secret_...) หรือ legacy service_role key (eyJ...) ก็ได้
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# ไม่บังคับ: ลิงก์เมนู "สลับระบบ" และ "ลงเวลา / การลา" (เว้นว่าง = ค่าเริ่มต้นใน src/lib/portal-links.ts)
NEXT_PUBLIC_PORTAL_URL=
NEXT_PUBLIC_ATTENDANCE_URL=
